{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Devaulty",
  "version": "0.1.10-alpha",
  "identifier": "com.devaulty.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/build-all.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Devaulty",
        "visible": false,
        "maximized": true,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "splash",
        "url": "/splash.html",
        "title": "Devaulty",
        "width": 550,
        "height": 400,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "nsis",
      "msi",
      "dmg"
    ],
    "resources": [
      "resources/devaulty-backend*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5ODg5QUNDRkI1QjNCOUIKUldTYk8xdjd6SnFJaWR4YmlGNStiZXVpRFFtMWVmZi9lUkZBL2ViOGZYNHd4ZWcxK2Ewai9ITTcK",
      "endpoints": [
        "https://github.com/MathCunha16/Devaulty/releases/latest/download/latest.json"
      ]
    }
  }
}
